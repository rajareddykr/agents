# ────────────────────────────────────────────────────────────────────────────
#  governed_app / .env
#
#  Copy to `.env` and fill in the three per-role tokens after you have
#  registered each agent in the AGT control-plane UI.
#
#  Register-once:  Governance → Agents → Register Agent
#     names MUST match the registered display names:
#         Coordinator Agent      → AGT_COORDINATOR_TOKEN
#         Financial Agent        → AGT_FIN_AGENT_TOKEN
#         Research Agent         → AGT_RES_AGENT_TOKEN
# ────────────────────────────────────────────────────────────────────────────

# --- Control plane ----------------------------------------------------------
AGT_CP_URL=http://localhost:20355
AGT_ORG_CODE=demodevelop
AGT_GOVERNANCE_ENABLED=true
AGT_HEARTBEAT_SECONDS=10
AGT_LOG_LEVEL=INFO

# --- IMPL-067 register-once + key escrow ------------------------------------
# Org-wide, host-local, ≥32 chars, NEVER transmitted. Encrypts the private
# key before escrow; a lost passphrase means every agent mints a new DID on
# next restart. Same value for every role on this host.
AGT_AGENT_PASSPHRASE=1iWGpS0rMhVfnbgNvl0qsLR32XndvsuoHRv6M38hd6k7hmTVBBtlkH7-gTlzBP8e

# Per-role durable credentials — shown ONCE by Register Agent in the UI.
AGT_COORDINATOR_TOKEN=
AGT_FIN_AGENT_TOKEN=
AGT_RES_AGENT_TOKEN=

# --- Runtime knobs ----------------------------------------------------------
# Distributed by default: three processes (see run.py).
HOST=127.0.0.1
COORD_PORT=8100
FIN_PORT=8101
RES_PORT=8102
