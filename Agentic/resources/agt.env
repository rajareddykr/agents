# ─────────────────────────────────────────────────────────────────────────────
#  AGT config for the customer agents — LOCAL control plane
#  Repointed from the Tata SaaS CP to our local AGT CP. The three agent files
#  load this file (setdefault), so launcher-injected values win and nothing
#  secret is hardcoded in source.
#
#  NOTE: keep every VALUE line free of trailing "# comments" — the simple .env
#  loader does not strip them. Put comments on their own lines like this.
# ─────────────────────────────────────────────────────────────────────────────

AGT_CP_URL=http://localhost:20355
AGT_ORG_CODE=demodevelop
AGT_GOVERNANCE_ENABLED=true
AGT_FAIL_OPEN=true
AGT_HEARTBEAT_SECONDS=10

# Evaluate the full policy RULES (and defaults.action) on the agent, not just
# blocked_actions/blocked_patterns. Required for allow-rule matches to be
# attributed to the CP bundle (Policy=cp-bundle) and for defaults.action=deny to
# take effect. The SDK defaults this to "off"; we turn it on.
AGT_POLICY_RULE_ENGINE=on

# No-LLM deterministic mode: replace the external LLM with a local planner so
# tools execute and AGT policies + A2A run with zero external deps. Set to 0 to
# use a real LLM gateway (via guardrails_config.json) instead.
AGT_NO_LLM=1

# Operator credentials used ONLY by run_customer_agents.py to auto-mint a fresh
# single-use bootstrap token per process on each launch.
AGT_OPERATOR_USER=demoadmin
AGT_OPERATOR_PASSWORD=changeme

# AGT_GATEWAY_API_KEY is intentionally NOT set for the local CP.

# ── Bind host / ports ────────────────────────────────────────────────────────
# Bind to 127.0.0.1 (not 0.0.0.0) to avoid Windows WinError 10013.
# Port 8080 was already in use on this machine, so the Coordinator UI uses 8090.
# Change AGENT_PORT if you prefer another free port — the UI, guardrail event
# ingest, and worker URLs all follow it automatically.
AGENT_HOST=127.0.0.1
AGENT_PORT=8090
FIN_PORT=8001
RES_PORT=8002
