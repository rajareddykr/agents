# Copy to .env. Everything here is OPTIONAL — the app runs fully offline on
# deterministic mock data with no configuration at all.

# --- Live market data (optional) -----------------------------------------
# Paste a Finnhub key to switch FIN MCP / NEWS MCP from mock to live data.
# FINNHUB_API_KEY=your_finnhub_key_here
# LIVE=1        # force live (needs a key) ; LIVE=0 forces mock

# --- Run mode / ports (optional) -----------------------------------------
# MODE=single           # single-process (default is distributed)
# HOST=127.0.0.1
# PORT=8000             # dashboard
# FIN_PORT=8071         # financial agent worker
# RES_PORT=8072         # research agent worker

# NOTE: there are intentionally NO AGT_* / mesh / bootstrap settings here.
# Those are added when you follow docs/AGT_MIGRATION_GUIDE.md.
